{
  "$schema": "https://kyroxova.github.io/schemas/continuumlib-config-v1.json",
  "schema_version": 1,
  "modid": "examplemod",
  "display_name": "Example Mod",
  "version": "1.0.0",
  "mode": "hybrid",
  "base": {
    "version": "1.18.2",
    "loader": "forge",
    "mappings": "mojmap",
    "java_target": 17
  },
  "targets": {
    "versions_file": "data/continuumlib/version/ContinuumLib.json",
    "loaders_file": "data/continuumlib/loader/ContinuumLib.json"
  },
  "output": {
    "jar_naming_format": "%modid%-%loader%-%version%.jar",
    "destination_path": "build/libs/%loader%/"
  }
}
